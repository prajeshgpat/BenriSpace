# Base URL of the BenriSpace API, including the /v1 prefix.
# Production: https://api.benrispace.com/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# How scores are computed: "grid" (default) serves the stored score of the grid cell;
# "point" asks the API to score the exact location on demand (?precision=point) and
# shows an "Exact-point score" caption. Experimental, for A/B testing.
NEXT_PUBLIC_SCORE_PRECISION=grid

# Optional. A PMTiles archive of the cell grid (scripts/build_tiles.py). Unset: cells are drawn from GeoJSON.
# NEXT_PUBLIC_PMTILES_URL=https://tiles.benrispace.com/benrispace-v1.pmtiles

# Optional. Origin of the static files on R2 (manifest.json, score file, area-score file, PMTiles).
# Anything missing or failing falls back to the API / NEXT_PUBLIC_PMTILES_URL. Needs CORS (incl. Range) on the bucket.
# NEXT_PUBLIC_STATIC_URL=https://tiles.benrispace.com

# Optional. Streaming chat endpoint (Lambda function URL, see docs/ARCHITECTURE.md). Unset: plain /chat.
# NEXT_PUBLIC_CHAT_STREAM_URL=https://example.lambda-url.us-east-1.on.aws/v1/chat/stream
