# Base URL of the BenriSpace API, including the /v1 prefix.
# Production: https://api.benrispace.com/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# How scores are computed: "grid" (default) serves the stored score of the grid cell;
# "point" asks the API to score the exact location on demand (?precision=point) and
# shows an "Exact-point score" caption. Experimental, for A/B testing.
NEXT_PUBLIC_SCORE_PRECISION=grid
