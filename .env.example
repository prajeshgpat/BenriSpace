# Copy to .env and fill in. Every unfilled var here maps to a checklist
# item in docs/ROADMAP.md's "Requirements from you" sections — see there for
# what account/step produces each value.

# --- Phase 1 blockers (docs/ROADMAP.md "Blocking Phase 1 today") ---
# Local default works out of the box against `docker compose up db`.
# Replace with the Supabase Postgres connection string once that project
# exists.
DATABASE_URL=

# --- Phase 2 (deferred by you — docs/ROADMAP.md Phase 2 Requirements) ---
# Set once Valhalla hosting is decided and stood up. Until then, airport
# drive-time ingestion falls back to straight-line distance.
VALHALLA_URL=

# --- Phase 3 (deferred by you — docs/ROADMAP.md Phase 3 Requirements) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Phase 4 (docs/ROADMAP.md Phase 4 Requirements) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SCORING_WEIGHTS_VERSION=

# Address autocomplete (api/suggest.py). Optional: without it suggestions use
# the slower keyless Photon service. Free tier at https://locationiq.com
LOCATIONIQ_API_KEY=
