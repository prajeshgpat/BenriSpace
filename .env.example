# Copy to .env and fill in. Every unfilled var here maps to a checklist
# item in PHASES.md's "Requirements from you" sections — see there for
# what account/step produces each value.

# --- Phase 1 blockers (PHASES.md "Blocking Phase 1 today") ---
# Local default works out of the box against `docker compose up db`.
# Replace with the Supabase Postgres connection string once that project
# exists.
DATABASE_URL=postgresql://benrispace:benrispace@localhost:5432/benrispace

# NJ Transit GTFS static feed requires developer registration (MTA/LIRR/
# Metro-North do not). https://www.njtransit.com/developer-tools
NJ_TRANSIT_API_KEY=
NJ_TRANSIT_API_USERNAME=

# Optional — trail popularity ingestion (ingestion/trails.py) works
# without this via OSM trail data alone; Strava adds real popularity
# metrics on top. https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Phase 2 (deferred by you — PHASES.md Phase 2 Requirements) ---
# Set once Valhalla hosting is decided and stood up. Until then, airport
# drive-time ingestion falls back to straight-line distance.
VALHALLA_URL=

# --- Phase 3 (deferred by you — PHASES.md Phase 3 Requirements) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Phase 4 (PHASES.md Phase 4 Requirements) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SCORING_WEIGHTS_VERSION=v1-handtuned
